[Unit]
Description=Persistent Google Chrome for HLTV (CDP 9222)
After=xvfb@99.service
Requires=xvfb@99.service

[Service]
# Dedicated VPS is root. Chrome refuses uid 0 unless --no-sandbox.
Environment=DISPLAY=:99
Environment=HOME=/var/lib/hltv-chrome
MemoryMax=900M
# MemoryMax is a RAM kill switch, not a swap balloon. No MemorySwapMax:
# cold pages may sit on the host swapfile.
ExecStart=/usr/bin/google-chrome-stable \
  --user-data-dir=/var/lib/hltv-chrome/profile \
  --remote-debugging-address=127.0.0.1 \
  --remote-debugging-port=9222 \
  --remote-allow-origins=* \
  --no-sandbox \
  --disable-setuid-sandbox \
  --no-first-run \
  --no-default-browser-check \
  --disable-dev-shm-usage \
  --disable-gpu \
  --disable-extensions \
  --renderer-process-limit=2 \
  --disk-cache-size=67108864 \
  --window-size=800,600 \
  --force-device-scale-factor=1 \
  --mute-audio \
  https://www.hltv.org/matches
# Restart=no: a new process drops JS-bound clearance. cdp down → human VNC.
Restart=no

[Install]
WantedBy=multi-user.target
