[Unit]
Description=HLTV Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hltv-bot
EnvironmentFile=/opt/hltv-bot/.env
# which uv  → 改成实际路径（root 常见 /root/.local/bin/uv）
ExecStart=/root/.local/bin/uv run python -m hltv_bot bot
Restart=always
RestartSec=5
# 1GB 机器别无限胀
MemoryMax=400M

[Install]
WantedBy=multi-user.target
